# ============================================
# PRODUCTION .env — TELEMEDICINE PLATFORM
# ============================================

# === PUBLIC (safe for frontend) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_APP_URL=https://your-domain.co.il
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit.livekit.cloud

# === SECRET (server only — NEVER NEXT_PUBLIC_) ===
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-...
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret

# === Payments (server only) ===
TRANZILA_TERMINAL_NAME=your-terminal-name

# === Invoicing (server only) ===
GREEN_INVOICE_API_KEY=your-green-invoice-api-key
GREEN_INVOICE_API_SECRET=your-green-invoice-api-secret

# === Notifications (server only) ===
INFOBIP_API_KEY=your-infobip-key
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_WHATSAPP_NUMBER=972501234567
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@your-domain.co.il

# === Cron (server only) ===
CRON_SECRET=your-cron-secret

# === Monitoring (server only) ===
SENTRY_DSN=https://...@sentry.io/...
