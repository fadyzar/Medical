# ============================================
# TELEMEDICINE PLATFORM — Environment Variables
# ============================================
# Copy this file to .env.local and fill in all values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables are server-only secrets — NEVER prefix them with NEXT_PUBLIC_.

# ─── PUBLIC (safe for frontend) ─────────────────────────

# Supabase project URL (from Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key — safe for browser, enforces RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Your production domain (used for SEO canonical URLs, sitemap, emails, callbacks)
NEXT_PUBLIC_APP_URL=https://your-domain.co.il

# LiveKit WebSocket URL for video calls (from LiveKit Cloud dashboard)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-app.livekit.cloud

# ─── SUPABASE (server only) ─────────────────────────────

# Supabase service role key — bypasses RLS, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── AI (server only) ───────────────────────────────────

# Anthropic API key for Claude AI agents (triage, summary, prescription, intake)
ANTHROPIC_API_KEY=sk-ant-...

# ─── VIDEO (server only) ────────────────────────────────

# LiveKit API credentials for generating room tokens and managing recordings
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ─── PAYMENTS — Tranzila (server only) ──────────────────

# Tranzila terminal name for iframe payment processing
TRANZILA_TERMINAL_NAME=your-terminal-name

# ─── PAYMENTS — Stripe Subscriptions (server only) ──────

# Stripe secret key for subscription billing (from Stripe dashboard → API keys)
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret (from Stripe dashboard → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for each subscription plan (from Stripe dashboard → Products)
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ─── INVOICING — Green Invoice (server only) ────────────

# Green Invoice API credentials for generating tax receipts (from greeninvoice.co.il)
GREEN_INVOICE_API_KEY=your-green-invoice-api-key
GREEN_INVOICE_API_SECRET=your-green-invoice-api-secret

# ─── NOTIFICATIONS — Email via Resend (server only) ─────

# Resend API key for transactional emails (from resend.com/api-keys)
RESEND_API_KEY=re_...

# Sender email address (must be verified in Resend dashboard)
RESEND_FROM_EMAIL=noreply@your-domain.co.il

# ─── NOTIFICATIONS — WhatsApp via Infobip (server only) ─

# Infobip credentials for WhatsApp reminders (from portal.infobip.com)
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_WHATSAPP_NUMBER=972501234567

# ─── CRON JOBS (server only) ────────────────────────────

# Secret token to authenticate Vercel cron job requests
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ─── MONITORING (server only, optional) ─────────────────

# Sentry DSN for error tracking (optional, from sentry.io)
# SENTRY_DSN=https://...@sentry.io/...
